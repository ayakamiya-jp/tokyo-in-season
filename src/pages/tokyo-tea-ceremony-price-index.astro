---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexBadge from '../components/IndexBadge.astro';
import EmailCapture from '../components/EmailCapture.astro';
import AuthorBio from '../components/AuthorBio.astro';
import HeroImage from '../components/HeroImage.astro';
import priceIndexHero from '../assets/hero/price-index-hero.jpg';
import {
  CURRENT_QUARTER as QUARTER,
  CURRENT_QUARTER_START as QUARTER_START,
  CURRENT_QUARTER_END as QUARTER_DATE,
  experiences as data,
  stats,
  previous,
  snapshots,
  exp,
  price,
  yen,
  pct,
} from '../lib/priceIndex';
import { getCollection } from 'astro:content';

const { median, minPrice, maxPrice, pctChairs, pctEnglish, chairsCount, englishCount } = stats;
const pricedCount = stats.priced;
const areaMedians = stats.areas;
const asakusaMedian = stats.area('Asakusa')?.median;
const ginzaMedian = stats.area('Ginza')?.median;

// Self-contained, quotable stat sentences for GEO citation
const jidaiya = exp('jidaiya-asakusa');
const keyFindings = [
  `As of ${QUARTER}, the median price of a tea ceremony experience in Tokyo is ${yen(median)}, per the Tokyo Tea Ceremony Price Index (${pricedCount} of ${data.length} tracked venues publish prices).`,
  `Prices range from ${yen(minPrice)} for a garden teahouse bowl of matcha to ${yen(maxPrice)} at the top end.`,
  asakusaMedian != null && ginzaMedian != null
    ? `The median price in Asakusa is ${yen(asakusaMedian)}, versus ${yen(ginzaMedian)} in Ginza.`
    : null,
  jidaiya.solo_price_jpy != null && jidaiya.price_jpy != null
    ? `Solo travelers can pay double: one venue charges ${price('jidaiya-asakusa', 'solo_price_jpy')} solo versus ${price('jidaiya-asakusa')} per person for groups of two or more.`
    : null,
  `Only ${chairsCount} of ${data.length} venues explicitly confirm chairs are available as an alternative to seiza floor seating.`,
].filter((f): f is string => f != null);

// Listing changes this quarter, in words (counts alone can't say why a listing left).
// Q4 2026: added tokyo-chaan-shibuya, imperial-hotel-tokoan, senrakuan-sendagi, wasako-asakusa, asakusa-kimono-matcha-sweets;
// fukagawa-geisha-tea and shibuya-private-tea no longer bookable;
// shibuya-authentic-tea merged into tea-room-kakoi-shibuya (same GetYourGuide listing).
const LISTING_CHANGES =
  'five venues were added (including the Imperial Hotel’s Toko-an tea room), two listings that are no longer bookable were dropped, and one duplicate listing was merged';

// Quarter-over-quarter changes vs the previous snapshot — self-contained, quotable sentences
const entries = await getCollection('experiences');
const changes: string[] = [];
if (previous) {
  const P = previous.stats;
  const qoq = `between ${previous.quarter} and ${QUARTER}`;
  const prevPrice = (id: string) => previous.experiences[id]?.price_jpy ?? null;
  const pricedBoth = entries.filter(e => prevPrice(e.id) != null && e.data.price_jpy != null);
  const raised = pricedBoth.filter(e => e.data.price_jpy! > prevPrice(e.id)!).length;
  const lowered = pricedBoth.filter(e => e.data.price_jpy! < prevPrice(e.id)!).length;
  const venues = (n: number) => `${n} venue${n === 1 ? '' : 's'}`;
  const moved = (from: number, to: number) => (from === to ? `held at ${yen(to)}` : `moved from ${yen(from)} to ${yen(to)}`);
  const pa = P.area('Asakusa')?.median;
  const pg = P.area('Ginza')?.median;

  changes.push(
    `The median price of a tea ceremony experience in Tokyo ${median === P.median ? `held at ${yen(median)}` : `${median < P.median ? 'eased' : 'rose'} from ${yen(P.median)} to ${yen(median)}`} ${qoq}, per the Tokyo Tea Ceremony Price Index. Of the ${pricedBoth.length} venues priced in both quarters, ${venues(raised)} raised prices and ${venues(lowered)} lowered them.`,
  );
  if (asakusaMedian != null && ginzaMedian != null && pa != null && pg != null) {
    changes.push(`By area, the Asakusa median ${moved(pa, asakusaMedian)} and the Ginza median ${moved(pg, ginzaMedian)} ${qoq}.`);
  }
  changes.push(
    minPrice === P.minPrice && maxPrice === P.maxPrice
      ? `The price range was unchanged quarter over quarter, at ${yen(minPrice)} to ${yen(maxPrice)}.`
      : `The price range moved from ${yen(P.minPrice)}–${yen(P.maxPrice)} in ${previous.quarter} to ${yen(minPrice)}–${yen(maxPrice)} in ${QUARTER}.`,
    `Venues explicitly confirming chair seating went from ${P.chairsCount} of ${P.listings} (${P.pctChairs}%) to ${chairsCount} of ${data.length} (${pctChairs}%) ${qoq}.`,
    `The share of tracked venues confirming English-language instruction ${englishCount === P.englishCount && data.length === P.listings ? 'held at' : `went from ${P.pctEnglish}% to`} ${pctEnglish}% (${englishCount} of ${data.length}) ${qoq}.`,
    `Published prices now cover ${pricedCount} of ${data.length} tracked venues (${pct(pricedCount, data.length)}%), versus ${P.priced} of ${P.listings} (${pct(P.priced, P.listings)}%) in ${previous.quarter}.`,
    `In ${QUARTER}, ${LISTING_CHANGES}, so the index tracks ${data.length} bookable experiences, versus ${P.listings} in ${previous.quarter}.`,
  );
}
---

<BaseLayout
  title={`How Much Is a Tea Ceremony in Tokyo? Prices for ${data.length} Venues (${QUARTER})`}
  description={`Tokyo tea ceremonies cost ¥${minPrice.toLocaleString()}–¥${maxPrice.toLocaleString()}, median ¥${median.toLocaleString()}. Compare prices by area, private vs group and kimono add-ons — ${data.length} venues, updated quarterly.`}
  ogType="website"
  ogImage={priceIndexHero}
>
  <HeroImage
    src={priceIndexHero}
    alt="A traditional tea ceremony setup on tatami mats, with an iron kettle, bamboo whisk, and chawan bowls"
    eyebrow="Data"
    title="Tokyo Tea Ceremony Price Index"
  />

  <div class="flex items-center gap-3 flex-wrap mb-8">
    <IndexBadge quarter={QUARTER} />
    <span class="text-sm text-warm-gray-mid">{data.length} listings surveyed</span>
  </div>

  {/* GEO answer block — phrased as a citable sentence */}
  <div class="bg-sakura-light border border-border p-7 mb-10">
    <p class="font-label text-xs uppercase tracking-wider text-sakura-deep mb-2">Quick answer</p>
    <p class="text-sumi leading-relaxed">
      As of {QUARTER}, the median price of a bookable group tea ceremony in Tokyo is{' '}
      <strong>¥{median.toLocaleString()}</strong>, with options ranging from{' '}
      ¥{minPrice.toLocaleString()} to ¥{maxPrice.toLocaleString()}.{' '}
      {pctChairs}% of listed experiences offer chair seating (no seiza required), and{' '}
      {pctEnglish}% provide English-language instruction.
      Data: <em>Tokyo Tea Ceremony Price Index, {QUARTER}</em>.
    </p>
  </div>

  {/* Headline stats */}
  <section class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-12">
    {[
      { label: 'Median price', value: `¥${median.toLocaleString()}`, highlight: true },
      { label: 'Price range', value: `¥${minPrice.toLocaleString()}–¥${maxPrice.toLocaleString()}`, highlight: false },
      { label: 'Chair seating available', value: `${pctChairs}%`, highlight: false },
      { label: 'English instruction', value: `${pctEnglish}%`, highlight: false },
    ].map(stat => (
      <div class:list={["p-4 text-center border", stat.highlight ? "bg-sakura-light border-border" : "bg-warm-gray border-border"]}>
        <p class:list={["font-display font-extrabold text-2xl tabular-nums", stat.highlight ? "text-sakura-deep" : "text-sumi"]}>{stat.value}</p>
        <p class="text-xs text-warm-gray-mid mt-1">{stat.label}</p>
      </div>
    ))}
  </section>

  {/* Quarter-over-quarter changes */}
  {previous && (
    <section class="mb-12" id="what-changed">
      <h2 class="font-display font-extrabold text-2xl text-sumi mb-4">What changed since last quarter</h2>
      <ul class="list-none border-t border-border">
        {changes.map(change => (
          <li class="py-5 border-b border-border text-sumi leading-relaxed">
            {change}
          </li>
        ))}
      </ul>
      <p class="text-xs text-warm-gray-mid mt-4">
        Compared with the{' '}
        <a href={`/tokyo-tea-ceremony-price-index/${previous.slug}/`} class="underline hover:text-sumi">
          {previous.quarter} edition
        </a>{' '}
        as published.
      </p>
    </section>
  )}

  {/* Price by area */}
  <section class="mb-12">
    <h2 class="font-display font-extrabold text-2xl text-sumi mb-6">Median price by area</h2>
    <div class="space-y-3">
      {areaMedians.map(({ area, median: m, count }) => (
        <div class="flex items-center gap-3">
          <span class="w-36 text-sm text-sumi flex-shrink-0 leading-tight">
            {area}
            <span class="text-warm-gray-mid text-xs block">{count} listing{count > 1 ? 's' : ''}</span>
          </span>
          <div class="flex-1 bg-warm-gray h-2">
            <div
              class="bg-matcha h-2"
              style={`width: ${Math.max(4, Math.round((m / maxPrice) * 100))}%`}
            />
          </div>
          <span class="text-sm font-medium text-sumi w-28 text-right whitespace-nowrap">
            ¥{m.toLocaleString()}
          </span>
        </div>
      ))}
    </div>
    <p class="text-xs text-warm-gray-mid mt-4">
      Median of lowest published adult rate per area. Areas with price-pending listings excluded from chart.
    </p>
  </section>

  {/* Key Findings — self-contained, quotable stats */}
  <section class="mb-12">
    <h2 class="font-display font-extrabold text-2xl text-sumi mb-4">Key Findings</h2>
    <ul class="list-none border-t border-border">
      {keyFindings.map(finding => (
        <li class="py-5 border-b border-border text-sumi leading-relaxed">
          {finding}
        </li>
      ))}
    </ul>
    <p class="text-xs text-warm-gray-mid mt-4">
      Prices are the lowest published adult per-person rates, read in JPY, checked on each booking page in October–November 2026. Updated quarterly.
    </p>
  </section>

  {/* Link to full comparison */}
  <section class="mb-12 p-5 border border-warm-gray-mid">
    <p class="font-semibold text-sumi mb-1">See the full comparison table</p>
    <p class="text-sm text-sumi/70 mb-3">
      Every listing side by side — price, area, chair seating, kimono add-on, and private booking —
      with practitioner ratings.
    </p>
    <a href="/tokyo-tea-ceremony-compared/" class="inline-block text-sm font-medium bg-matcha hover:bg-matcha-light text-white px-4 py-2 transition-colors">
      Compare all experiences →
    </a>
  </section>

  {/* Methodology */}
  <section class="mb-12" id="methodology">
    <h2 class="font-display font-extrabold text-2xl text-sumi mb-4">Methodology</h2>
    <div class="prose max-w-none text-sumi/80 space-y-3">
      <p>
        The Tokyo Tea Ceremony Price Index is a structured manual survey of bookable tea ceremony
        experiences in Tokyo. It is compiled by Suzu, an active Urasenke tea ceremony student,
        and updated once per quarter (Q1–Q4).
      </p>
      <p>
        <strong>Inclusion criteria:</strong> experiences must be bookable in advance (platform
        listing or direct reservation page), offer English instruction or guidance, and be
        currently active as of the survey date.
      </p>
      <p>
        <strong>Price definition:</strong> the lowest published adult rate at the time of
        survey, excluding optional add-ons (kimono rental, private upgrade) and seasonal
        surcharges (sakura, autumn foliage) unless the surcharge represents the year-round
        base price.
      </p>
      <p>
        <strong>Practitioner rating:</strong> each listing receives a rating of A
        (Practitioner's pick), B (Good for tourists), or C (Skip) based on direct knowledge
        of tea ceremony standards, venue quality, and how accurately the experience represents
        the tradition. Ratings reflect personal professional judgment and are updated as
        first-hand information changes.
      </p>
      <p>
        <strong>Update cadence:</strong> full survey conducted quarterly. Individual listings
        are flagged and re-checked if a price change is detected or if more than 90 days
        have elapsed since last verification.
      </p>
      <ul class="text-sm space-y-1 list-none not-prose mt-2 border-t border-warm-gray pt-3">
        <li><strong>Last full update:</strong> {QUARTER}</li>
        <li><strong>Listings surveyed:</strong> {data.length}</li>
        <li><strong>Prices confirmed:</strong> {pricedCount} of {data.length}</li>
        <li><strong>Coverage:</strong> 23 wards of Tokyo</li>
      </ul>
      <p class="text-sm not-prose mt-3">
        <a href="/downloads/tokyo-tea-ceremony-price-index.csv" download class="text-matcha underline hover:text-matcha-light">
          Download the full dataset (CSV) →
        </a>
      </p>
      {snapshots.length > 0 && (
        <p class="text-sm not-prose mt-3">
          <strong>Previous editions:</strong>{' '}
          {snapshots.map((s, i) => (
            <>
              {i > 0 && ' · '}
              <a href={`/tokyo-tea-ceremony-price-index/${s.slug}/`} class="text-matcha underline hover:text-matcha-light">{s.quarter}</a>
            </>
          ))}
        </p>
      )}
    </div>
  </section>

  <EmailCapture />
  <AuthorBio />

  {/* Dataset schema */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    'name': `Tokyo Tea Ceremony Price Index — ${QUARTER}`,
    'description': `Structured quarterly survey of bookable tea ceremony experiences in Tokyo. As of ${QUARTER}: median price ¥${median.toLocaleString()}, range ¥${minPrice.toLocaleString()}–¥${maxPrice.toLocaleString()}, ${pctChairs}% offering chair seating, ${pctEnglish}% with English instruction. ${data.length} listings surveyed.`,
    'creator': {
      '@type': 'Person',
      'name': 'Suzu',
      'url': 'https://tokyoinseason.com/about/',
    },
    'publisher': {
      '@type': 'Organization',
      'name': 'Tokyo in Season',
      'url': 'https://tokyoinseason.com',
    },
    'url': 'https://tokyoinseason.com/tokyo-tea-ceremony-price-index/',
    'keywords': ['tea ceremony', 'Tokyo', 'price', 'Japan travel', 'Urasenke', 'matcha experience'],
    'temporalCoverage': `${QUARTER_START}/${QUARTER_DATE}`,
    'spatialCoverage': {
      '@type': 'Place',
      'name': 'Tokyo, Japan',
    },
    'measurementTechnique': 'Manual survey of published booking prices by an Urasenke tea ceremony practitioner',
    'license': 'https://creativecommons.org/licenses/by/4.0/',
    'isAccessibleForFree': true,
    'mainEntityOfPage': 'https://tokyoinseason.com/tokyo-tea-ceremony-price-index/',
    'distribution': {
      '@type': 'DataDownload',
      'encodingFormat': 'text/csv',
      'contentUrl': 'https://tokyoinseason.com/downloads/tokyo-tea-ceremony-price-index.csv',
    },
  })} />
</BaseLayout>
