---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { kimonoGuides } from '../data/kimonoGuides';

const featuredGuide = kimonoGuides.find(g => g.featured) ?? kimonoGuides[0];
const restGuides = kimonoGuides.filter(g => g !== featuredGuide);
---

<BaseLayout
  title="Kimono Guides"
  description="Every kimono guide on Tokyo in Season — how to pick a good rental shop, where to rent near Tokyo, and dressing for the season you're actually visiting in."
  ogImage={featuredGuide.image}
  wide
>
  <section class="pt-2 sm:pt-6 pb-10 sm:pb-14">
    <span class="block font-label text-xs uppercase tracking-wider text-sakura-deep mb-5">Kimono</span>
    <h1 class="font-display font-extrabold text-4xl sm:text-5xl leading-[1.04] tracking-tight text-sumi mb-6" style="text-wrap:balance">
      All Kimono Guides
    </h1>
    <p class="max-w-md text-[1.1rem] leading-snug text-sumi-soft mb-8">
      {kimonoGuides.length} guides from someone who wears kimono to the tea room — where to rent, what to check at the counter, and awase vs hitoe by season.
    </p>
    <div class="flex items-center gap-6 flex-wrap">
      <a href="/tokyo-tea-ceremony-compared" class="inline-flex items-center gap-2 btn-line font-sans text-[15px] px-7 py-3.5">
        Tea in kimono <span class="btn-arrow">→</span>
      </a>
      <a href="/tea-ceremony" class="text-sumi font-semibold text-sm border-b border-sumi/40 hover:border-sumi transition-colors">
        Tea Ceremony Guides →
      </a>
    </div>
  </section>

  <section class="mt-6">
    <a href={featuredGuide.href} class="group grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-6 lg:gap-10 items-center mb-14">
      <div class="aspect-[4/3] lg:aspect-[4/5] overflow-hidden border border-border bg-surface">
        <Image
          src={featuredGuide.image}
          alt={featuredGuide.alt}
          widths={[600, 900, 1300, 1800]}
          sizes="(min-width: 1024px) 560px, 100vw"
          class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        />
      </div>
      <div>
        <span class="block font-label text-[0.65rem] uppercase tracking-wider text-sakura-deep mb-3">{featuredGuide.tag}</span>
        <h2 class="font-display font-extrabold text-3xl sm:text-[2.1rem] leading-tight text-sumi mb-3">{featuredGuide.title}</h2>
        <p class="text-base text-sumi-soft max-w-md mb-3">{featuredGuide.desc}</p>
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-sumi border-b border-sumi/40">
          Read the guide <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
        </span>
      </div>
    </a>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
      {restGuides.map(guide => (
        <a href={guide.href} class="group block">
          <div class="aspect-[4/5] overflow-hidden border border-border bg-surface mb-4">
            <Image
              src={guide.image}
              alt={guide.alt}
              widths={[400, 600, 900]}
              sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
            />
          </div>
          <span class="block font-label text-[0.62rem] uppercase tracking-wider text-sakura-deep mb-1.5">{guide.tag}</span>
          <h3 class="font-display font-extrabold text-lg leading-tight text-sumi mb-1.5">{guide.title}</h3>
          <p class="text-sm text-sumi-soft leading-snug mb-1.5 line-clamp-2">{guide.desc}</p>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-sumi border-b border-sumi/40">
            Read the guide <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
