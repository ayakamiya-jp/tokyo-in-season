---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import StickyCompareCta from '../components/StickyCompareCta.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  wide?: boolean;
  showCompareCta?: boolean;
  ogImage?: ImageMetadata;
}

const {
  title,
  description,
  canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString(),
  ogType = 'website',
  wide = false,
  showCompareCta = false,
  ogImage,
} = Astro.props;

const siteName = 'Tokyo in Season';
const tagline = 'Japanese culture, in its right season — from inside the tea room.';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;

const resolvedOgImage = ogImage
  ? await getImage({ src: ogImage, width: 1200, height: 630 })
  : null;
const ogImageUrl = resolvedOgImage ? new URL(resolvedOgImage.src, Astro.site).toString() : null;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="p:domain_verify" content="30a804a8a0e1d3260af27f9490ca6e6d" />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content={siteName} />
  {ogImageUrl && (
    <>
      <meta property="og:image" content={ogImageUrl} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta name="twitter:card" content="summary_large_image" />
    </>
  )}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Inter:wght@400;500;600&family=Jost:wght@500&display=swap" rel="stylesheet" />

  <!-- Site schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": siteName,
    "url": Astro.site,
    "description": tagline,
  })} />
</head>
<body class="bg-warm-white text-sumi font-sans antialiased overflow-x-hidden">
  <header class="sticky top-0 z-50 bg-warm-white/90 backdrop-blur border-b border-border">
    <div class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between gap-3">
      <a href="/" class="font-display font-extrabold text-base sm:text-lg tracking-tight text-sumi whitespace-nowrap">
        Tokyo in Season
      </a>
      <nav class="flex gap-2.5 sm:gap-8 font-label text-[0.65rem] sm:text-xs uppercase tracking-wider whitespace-nowrap">
        <a href="/tokyo-tea-ceremony-compared" class="group relative pb-0.5">
          Compare
          <span class="absolute left-0 bottom-0 h-px w-full bg-sakura-deep scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-200"></span>
        </a>
        <a href="/tokyo-tea-ceremony-price-index" class="group relative pb-0.5">
          <span class="sm:hidden">Index</span><span class="hidden sm:inline">Price Index</span>
          <span class="absolute left-0 bottom-0 h-px w-full bg-sakura-deep scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-200"></span>
        </a>
        <a href="/about" class="group relative pb-0.5">
          About
          <span class="absolute left-0 bottom-0 h-px w-full bg-sakura-deep scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-200"></span>
        </a>
      </nav>
    </div>
  </header>

  <main class:list={["mx-auto px-4 py-6 sm:py-12", wide ? "max-w-6xl" : "max-w-3xl"]}>
    <slot />
  </main>

  {showCompareCta && <StickyCompareCta />}

  <footer class="border-t border-border mt-16 pt-12 pb-8">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-[1.4fr_1fr_1fr] gap-9">
        <div>
          <p class="font-display font-extrabold text-base text-sumi mb-1.5">Tokyo in Season</p>
          <p class="text-sm text-warm-gray-mid max-w-xs leading-relaxed">
            Japanese culture, in its right season — from inside the tea room.
          </p>
        </div>
        <div>
          <p class="font-label text-xs uppercase tracking-wider text-warm-gray-mid mb-3">Explore</p>
          <ul class="space-y-2 text-sm">
            <li><a href="/tokyo-tea-ceremony-compared" class="hover:text-sakura-deep transition-colors">Compare</a></li>
            <li><a href="/tokyo-tea-ceremony-price-index" class="hover:text-sakura-deep transition-colors">Price Index</a></li>
            <li><a href="/about" class="hover:text-sakura-deep transition-colors">About</a></li>
          </ul>
        </div>
        <div>
          <p class="font-label text-xs uppercase tracking-wider text-warm-gray-mid mb-3">Legal</p>
          <ul class="space-y-2 text-sm">
            <li><a href="/disclaimer" class="hover:text-sakura-deep transition-colors">Disclaimer</a></li>
            <li><a href="/privacy" class="hover:text-sakura-deep transition-colors">Privacy</a></li>
            <li><a href="/sitemap-index.xml" class="hover:text-sakura-deep transition-colors">Sitemap</a></li>
          </ul>
        </div>
      </div>
      <div class="mt-10 pt-6 border-t border-border text-xs text-legal-gray space-y-1">
        <p>© {new Date().getFullYear()} Tokyo in Season · Written by Suzu, an Urasenke practitioner in Tokyo</p>
        <p>Some links are affiliate links — we may earn a small commission at no extra cost to you.</p>
      </div>
    </div>
  </footer>
</body>
</html>
