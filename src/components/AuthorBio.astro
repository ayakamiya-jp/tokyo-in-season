---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<aside class:list={["author-bio bg-surface border border-border", compact ? "p-4" : "p-6 my-8"]}>
  <div class="flex items-start gap-4">
    <img
      src="/favicon.svg"
      alt="Suzu, Urasenke tea ceremony practitioner"
      class="w-14 h-14 rounded-full flex-shrink-0"
      width="64"
      height="64"
    />
    <div>
      <p class="font-label text-xs uppercase tracking-wider text-warm-gray-mid mb-1">Written by</p>
      <p class="font-display font-extrabold text-lg text-sumi leading-tight">Suzu</p>
      <p class="text-sm text-sumi-soft mt-1.5">
        Urasenke-trained tea ceremony practitioner based in Tokyo. I write about authentic
        Japanese cultural experiences to help travellers find the real thing.
      </p>
      {!compact && (
        <p class="text-sm mt-2">
          <a href="/about" class="text-matcha font-medium hover:underline">Learn more about my practice →</a>
        </p>
      )}
    </div>
  </div>
</aside>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Suzu",
  "description": "Urasenke tea ceremony practitioner and Japanese culture guide author based in Tokyo",
  "url": "https://tokyoinseason.com/about",
  "knowsAbout": ["Tea Ceremony", "Japanese Culture", "Urasenke", "Wabi-sabi", "Wagashi"]
}
</script>
